{
  "name": "antrom-guildstone-ring",
  "version": "1.8.4",
  "description": "Knights of Antrom: AFK Companion - the AntromAFK idle loop as a smart wearable you carry anywhere in Decentraland",
  "scripts": {
    "start": "sdk-commands start",
    "build": "sdk-commands build",
    "pack": "node scripts/stamp-description.js && sdk-commands pack-smart-wearable",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.25.1-30310486734.commit-5ffe873",
    "@dcl/sdk": "7.25.1-30310486734.commit-5ffe873",
    "@dcl/sdk-commands": "7.25.1-30310486734.commit-5ffe873"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
